# Large / regenerable data - distributed via Zenodo + HuggingFace, not git
data/raw/
data/raw_laws/
data/raw_api/
data/meta/
data/*.jsonl
data/*.csv
data/*.gz
# also exclude the versioned data backups (large binaries, kept locally only)
data/**/*.jsonl
data/**/*.csv
data/**/*.gz

# Logs / temp
*.log
*.tmp

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS/IDE
.DS_Store
.vscode/
.idea/

# private planning notes
docs/PUBLICATION_PLAN*.md

# data-descriptor paper draft - kept LOCAL only until submitted to a journal
paper/

# paper/ build junk - track only the cleaned LaTeX source + figures if desired
paper/latex/tectonic            # 60 MB tectonic binary
paper/latex/mdpi_src/           # upstream MDPI template clone (has its own .git, large .eps, template.pdf)
paper/**/*.bak_dashes           # pre-dash-fix backups
paper/**/*.aux
paper/**/*.out
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/latex/pics/*.eps          # large EPS logos; the build uses the .pdf versions
